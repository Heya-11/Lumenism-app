{
 "name": "Lumenism",
 "short_name": "Lumenism",
 "description": "사진 보정",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "orientation": "any",
 "background_color": "#141414",
 "theme_color": "#101010",
 "lang": "ko",
 "icons": [
  {
   "src": "assets/icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "assets/icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "assets/icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "photos",
     "accept": [
      "image/*",
      "image/x-adobe-dng",
      ".jpg",
      ".jpeg",
      ".png",
      ".webp",
      ".heic",
      ".dng",
      ".cr2",
      ".cr3",
      ".nef",
      ".nrw",
      ".arw",
      ".srw",
      ".raf",
      ".orf",
      ".rw2",
      ".pef"
     ]
    }
   ]
  }
 }
}